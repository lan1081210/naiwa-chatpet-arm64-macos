+//go:build windows
+
+package main
+
+// 联机功能已移除。房间列表、局域网搜索、服务器探测、断线重连都不再存在，
+// 这里只保留设置页仍然引用的空实现：任何联机动作都只会提示“已移除”。
+
+type lobbyRoom struct {
+	Code    string
+	Players int
+	Address string
+}
+
+type lanSearchResult struct {
+	rooms []lobbyRoom
+	err   error
+}
+
+const fightOnlineRemoved = "联机功能已移除，本版本只支持单机挑战"
+
+func (g *gamePanel) refreshLAN()                 {}
+func (g *gamePanel) updateLANList([]lobbyRoom)   {}
+func (g *gamePanel) startLANSearch(string, bool) {}
+func (g *gamePanel) joinLANRoom(string) {
+	g.statusError = fightOnlineRemoved
+}
+func (g *gamePanel) createLANRoom() {
+	g.statusError = fightOnlineRemoved
+}
+func (g *gamePanel) toggleConnectionMode() {}
+func (g *gamePanel) openLANPermissions()   {}
+func (g *gamePanel) startProbe(string) {
+	g.statusError = fightOnlineRemoved
+}
+func (g *gamePanel) saveServer() bool {
+	g.statusError = fightOnlineRemoved
+	return false
+}
+func (g *gamePanel) selectedLANRoom() (lobbyRoom, bool) { return lobbyRoom{}, false }
+
+func (a *desktopHost) createLANRoom()                    { a.lobbyRemovedNotice() }
+func (a *desktopHost) beginOnline(string)                { a.lobbyRemovedNotice() }
+func (a *desktopHost) lobbyRemovedNotice() {
+	if a.play != nil && a.play.gamePanel != nil {
+		a.play.gamePanel.statusError = fightOnlineRemoved
+		a.play.gamePanel.refresh()
+	}
+}
+
+func validLobbyCode(code string) bool { return false }
